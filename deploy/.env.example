# Режим: webhook (прод) | polling (локальная разработка)
MODE=webhook

# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Только для MODE=webhook
WEBHOOK_URL=https://bot.example.com/webhook/replace-with-random-suffix
# openssl rand -hex 32
WEBHOOK_SECRET=

# Ваш Telegram ID (узнать у @userinfobot) — получает роль sysadmin
OWNER_TG_ID=

# Подключение к Postgres (в docker-compose хост — db)
DB_URL=postgres://secureask:CHANGE_ME@db:5432/secureask
# Пароль Postgres для docker-compose: openssl rand -hex 24
DB_PASSWORD=CHANGE_ME

# Криптоключи: openssl rand -base64 32 (сгенерировать ОДИН раз и сохранить!
# Потеря ключей = невозможность расшифровать отправителей и недействительность блокировок)
ENCRYPTION_KEY=
HMAC_KEY=

# Первый администратор веб-панели. Создаётся при ПЕРВОМ запуске (пустая таблица
# admin_accounts). Позже смена этих значений ничего не меняет — правьте через панель.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Антифлуд (необязательно, дефолты разумные)
#RATE_BURST_PER_HOUR=5
#RATE_DAILY_LIMIT=20

# HTTP-адрес внутри контейнера (edge/Caddy проксирует сюда по сети web)
#LISTEN_ADDR=:8080

# Папка с собранной веб-панелью. В Docker-образе уже задана (=/web),
# прописывать здесь не нужно. Пусто — панель не раздаётся (например, локально
# через Vite-dev, который сам проксирует /api на :8080).
#WEB_DIR=/web
